# ---- Godot 4 ----
# Cache de importacao e dados locais do editor.
.godot/
# Pasta gerada pelo build Android.
/android/

# ---- Builds e exports locais ----
build/
builds/
export/
exports/
# O preset de exportacao E versionado a partir da Etapa 12: ele descreve o que entra no
# pacote de Windows e precisa viajar com o repositorio. Ele nao guarda credencial alguma —
# nao ha assinatura de codigo nem deploy remoto configurados.
*.exe
*.pck
*.dmg
*.app

# ---- Sistema operacional ----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Editores e IDEs ----
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Observacao: assets, cenas, scripts, arquivos .import, dados e documentacao
# do projeto SAO versionados e nao devem entrar nesta lista.
